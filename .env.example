# Flask
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Gemini
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=models/gemini-2.5-flash

# MSSQL
MSSQL_CONN_STR=DRIVER={ODBC Driver 17 for SQL Server};SERVER=<server>;DATABASE=<database>;UID=<user>;PWD=<password>

# ChromaDB storage path
CHROMADB_PATH=data/chromadb_data

# Auth (JSON array)
AUTH_USERS=[{"email":"admin@example.com","password":"<password>"}]
